# --- Application ---
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:4200

# --- Base de données Neon ---
# Connexion "pooled" (hôte avec -pooler) pour l'application
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Connexion directe pour les migrations Prisma
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Authentification ---
# 64 caractères aléatoires minimum (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false            # true en production

# --- Création automatique de l'administrateur (facultatif : CI et tests uniquement) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false                # true : crée seulement les deux applications de laboratoire

# --- Rapports PDF ---
REPORT_MAX_FINDINGS=500
REPORT_MAX_PAGES=150
REPORT_EXPORTS_PER_HOUR=20

# --- Import ---
MAX_IMPORT_MB=10
MAX_ALERTS_PER_IMPORT=5000

# --- M1 entraîné (service d'inférence ml/m1) ---
# simulated (défaut) ou trained. En cas d'indisponibilité du service, repli sur la simulation (marquée simulée).
M1_PROVIDER=simulated
M1_SERVICE_URL=
M1_SERVICE_TOKEN=
M1_TIMEOUT_MS=5000

# --- Simulation de M2 (et de M1 tant qu'il n'est pas entraîné) ---
PREDICTION_PROVIDER=rules      # rules | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=               # à renseigner depuis la documentation officielle
LLM_MAX_CALLS_PER_IMPORT=20
LLM_TIMEOUT_MS=20000

# --- Service du front-end (production, une seule origine) ---
# Dossier du build Angular servi par NestJS ; laisser vide en développement
FRONTEND_DIST=
